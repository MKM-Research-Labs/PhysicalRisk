              "cdm_path": "PhysicalSwap.Header.ValuationDate",
              "computation": "datetime.now().strftime('%Y-%m-%d')"
            },
            "trade_status": {
              "label": "Trade Status",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.Header.TradeStatus",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.Header.TradeStatus",
