{
  "version": "1.0.0",
  "description": "Field-level data lineage registry — maps every field on every report/screen to its data source. BCBS 239 Principle 3 (Accuracy & Integrity).",
  "last_updated": "2026-03-19T00:00:00",
  "reports": {
    "eod_report": {
      "label": "End-of-Day Trading Report",
      "generator": "src/reports/trading/eod_generator.py",
      "sections": {
        "executive_summary": {
          "label": "Executive Summary (Page 1)",
          "fields": {
            "eod_date": {
              "label": "EOD Date",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "eod_date",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "snapshot timestamp"
            },
            "open_positions": {
              "label": "Number of Open Positions",
              "source_file": "data/output/prs/*.json",
              "source_field": "count(TradeStatus='Committed')",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.Header.TradeStatus",
              "computation": "count of open trades"
            },
            "total_notional": {
              "label": "Total Notional (GBP)",
              "source_file": "data/output/prs/*.json",
              "source_field": "sum(LegData.Notional)",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.LegData.Notional",
              "computation": "sum of signed notionals across open trades"
            },
            "daily_pnl": {
              "label": "Daily P&L (GBP)",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "daily_pnl",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "new_trade_pnl + market_move_pnl (from delta_engine + pnl_engine)"
            },
            "new_trade_pnl": {
              "label": "New Trade P&L",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "new_trade_pnl",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "sum(NPV) for trades opened today"
            },
            "market_move_pnl": {
              "label": "Market Move P&L",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "market_move_pnl",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "sum(current_fair - prev_fair) * risky_annuity * notional / 10000"
            },
            "running_pnl": {
              "label": "Running P&L",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "running_pnl",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "MTM from inception = sum(fair_spread - trade_spread) * risky_annuity * notional / 10000"
            }
          }
        },
        "positions": {
          "label": "Outstanding Positions (Page 2)",
          "fields": {
            "swap_id": {
              "label": "Swap ID",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.Header.SwapID",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.Header.SwapID",
              "computation": "direct read"
            },
            "gauge_id": {
              "label": "Gauge",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.GaugeSet.GaugeBasket[0].GaugeID",
              "pipeline_step": "gauges",
              "cdm_path": "PhysicalSwap.GaugeSet.GaugeBasket[].GaugeID",
              "computation": "deterministic hash: GAUGE-{sha256(catchment+name+lat+lon)[:8]}"
            },
            "trigger": {
              "label": "Trigger Level",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.Pricing.TriggerLevel",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.Pricing.TriggerLevel",
              "computation": "direct read (alert|warning|severe)"
            },
            "notional": {
              "label": "Notional (GBP)",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.LegData.Notional",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.LegData.Notional",
              "computation": "signed by direction: Pay=negative, Rcv=positive"
            },
            "tenor": {
              "label": "Tenor (Y)",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "derived from ScheduleData.StartDate/EndDate",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.ScheduleData",
              "computation": "(EndDate - StartDate) in years"
            },
            "trade_spread": {
              "label": "Trade Spread (bps)",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.Pricing.SpreadBps",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.Pricing.SpreadBps",
              "computation": "round(fair_spread + random_offset) where offset in [3,10]bp"
            },
            "fair_spread": {
              "label": "Fair Spread (bps)",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].term_structure[tenor]",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "GEV exceedance × base_rate → hazard rate → CDS-analogy spread"
            },
            "fs01": {
              "label": "FS01 (GBP)",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "risky_annuity × notional / 10000 × direction_sign (from delta_engine)"
            },
            "daily_pnl_per_trade": {
              "label": "Daily P&L",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "positions[].daily_pnl",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "new_trade_pnl (if new) + market_move_pnl"
            },
            "running_pnl_per_trade": {
              "label": "Running P&L",
              "source_file": "data/output/trading/eod/<date>.json",
              "source_field": "positions[].running_pnl",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "(fair_spread - trade_spread) × risky_annuity × notional / 10000"
            }
          }
        }
      }
    },
    "gauge_hazard_panel": {
      "label": "Gauge Hazard Curve Panel",
      "generator": "src/visual/interactivity/gauge/gaugehc/",
      "sections": {
        "hazard_curve": {
          "label": "Tab 1: Hazard Curve",
          "fields": {
            "hazard_rate": {
              "label": "Hazard Rate (bps)",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].hazard_rate",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "P(flood in year t | no flood before t) from GEV fit × base_rate"
            },
            "survival_probability": {
              "label": "Survival Probability",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].survival_prob",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "S(t) = prod(1 - h(s)) for s in [1..t]"
            },
            "alert_level": {
              "label": "Alert Threshold (m)",
              "source_file": "data/input/<catchment>/gauge.json",
              "source_field": "flood_gauges[].FloodStages.FloodAlertLevel",
              "pipeline_step": "gauges",
              "cdm_path": "FloodGauge.FloodStages.FloodAlertLevel",
              "computation": "direct read from CDM"
            },
            "warning_level": {
              "label": "Warning Threshold (m)",
              "source_file": "data/input/<catchment>/gauge.json",
              "source_field": "flood_gauges[].FloodStages.FloodWarningLevel",
              "pipeline_step": "gauges",
              "cdm_path": "FloodGauge.FloodStages.FloodWarningLevel",
              "computation": "direct read from CDM"
            },
            "severe_level": {
              "label": "Severe Threshold (m)",
              "source_file": "data/input/<catchment>/gauge.json",
              "source_field": "flood_gauges[].FloodStages.SevereFloodLevel",
              "pipeline_step": "gauges",
              "cdm_path": "FloodGauge.FloodStages.SevereFloodLevel",
              "computation": "direct read from CDM"
            },
            "market_curve_overlay": {
              "label": "Market Hazard Curve (dashed)",
              "source_file": "data/output/trading/market_state.json",
              "source_field": "hazard_term_structures[gauge_id][trigger]",
              "pipeline_step": null,
              "cdm_path": null,
              "computation": "user-adjusted via trading desk market tab"
            }
          }
        },
        "term_structure": {
          "label": "Tab 2: Term Structure",
          "fields": {
            "annual_hazard_rate": {
              "label": "Annual Hazard Rate by Tenor",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].term_structure",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "base_rate × (1 + slope × t) for each tenor, from GEV exceedance"
            }
          }
        },
        "prs_pricing": {
          "label": "Tab 3: PRS Pricing",
          "fields": {
            "fair_spread": {
              "label": "Fair Spread (bps)",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].term_structure[tenor]",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "CDS-analogy: protection_leg_pv / risky_annuity × 10000"
            },
            "npv": {
              "label": "NPV (GBP)",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "protection_leg_pv - premium_leg_pv (from prs_analytical.py)"
            },
            "premium_leg_pv": {
              "label": "Premium Leg PV (GBP)",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "sum(spread × dt × notional × S_t × df)"
            },
            "protection_leg_pv": {
              "label": "Protection Leg PV (GBP)",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "sum(notional × (1-R) × (S(t-1) - S(t)) × df)"
            },
            "risky_annuity": {
              "label": "Risky Annuity",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "sum(dt × S_t × df) for semi-annual periods"
            },
            "yield_curve": {
              "label": "Yield Curve",
              "source_file": "data/output/trading/market_state.json",
              "source_field": "yield_curve",
              "pipeline_step": null,
              "cdm_path": null,
              "computation": "DEFAULT_YIELD_CURVE {1Y:3.5%, 2Y:4%, ...} or user-adjusted via market tab"
            },
            "recovery_rate": {
              "label": "Recovery Rate",
              "source_file": null,
              "source_field": "hardcoded",
              "pipeline_step": null,
              "cdm_path": null,
              "computation": "0.0 (no recovery on physical flood payout)"
            },
            "counterparty": {
              "label": "Counterparty",
              "source_file": "data/input/<catchment>/counterparty.json",
              "source_field": "counterparties[]",
              "pipeline_step": "counterparties",
              "cdm_path": null,
              "computation": "direct read"
            }
          }
        },
        "stress_test": {
          "label": "Tab 5: Stress Test",
          "fields": {
            "flood_probability": {
              "label": "Flood Probability (%)",
              "source_file": "data/output/stress/GAUGE-*.joblib",
              "source_field": "GBM classifier prediction",
              "pipeline_step": "stressm",
              "cdm_path": null,
              "computation": "GBM v1.3 predict_proba() on 4 log-transformed features"
            },
            "hydrograph": {
              "label": "Hydrograph (Water Level vs Time)",
              "source_file": "data/input/<catchment>/gaugets/GAUGE-*.json",
              "source_field": "storm_responses[storm_id]",
              "pipeline_step": "stressm",
              "cdm_path": null,
              "computation": "synthesized: sin(rise) + exp(decay) from storm params"
            },
            "stress_pnl": {
              "label": "Stress P&L (GBP)",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "blotter",
              "cdm_path": null,
              "computation": "cash_price - MTM where cash_price = notional × P(flood) × direction"
            },
            "storm_scenario": {
              "label": "Storm Scenario",
              "source_file": "data/input/<catchment>/stress_storms/{storm_id}.json",
              "source_field": "storms[]",
              "pipeline_step": "stressm",
              "cdm_path": null,
              "computation": "260 storms that breached alert threshold (from 10,000)"
            }
          }
        }
      }
    },
    "property_hazard_panel": {
      "label": "Property Hazard Curve Panel",
      "generator": "src/visual/interactivity/property/phc_*.py",
      "sections": {
        "hazard_curve": {
          "label": "Tab 0: Exceedance Probability",
          "fields": {
            "exceedance_probability": {
              "label": "Exceedance Probability (%)",
              "source_file": "data/input/<catchment>/propertyhc.json",
              "source_field": "property_hazard_curves[prop_id]",
              "pipeline_step": "propertyhc",
              "cdm_path": null,
              "computation": "GEV fit on flood depths from propertyts events"
            },
            "flood_depth_thresholds": {
              "label": "Depth Thresholds (0m, 0.5m, 1.0m)",
              "source_file": "config/models.py",
              "source_field": "DEPTH_THRESHOLDS",
              "pipeline_step": null,
              "cdm_path": null,
              "computation": "hardcoded: any_flood=0m, moderate=0.5m, severe=1.0m"
            },
            "annual_probabilities": {
              "label": "Annual Exceedance Probabilities",
              "source_file": "data/input/<catchment>/propertyhc.json",
              "source_field": "property_hazard_curves[prop_id].exceedance_probs",
              "pipeline_step": "propertyhc",
              "cdm_path": null,
              "computation": "GEV exceedance × base_rate per depth threshold"
            },
            "gev_parameters": {
              "label": "GEV Parameters (shape, loc, scale)",
              "source_file": "data/input/<catchment>/propertyhc.json",
              "source_field": "property_hazard_curves[prop_id].gev_params",
              "pipeline_step": "propertyhc",
              "cdm_path": null,
              "computation": "MLE fit on flood depth maxima (models/hazard/gev.py)"
            }
          }
        },
        "prs_pricing": {
          "label": "Tab 2: PRS Pricing (6-Component)",
          "fields": {
            "gauge_components": {
              "label": "Nearest Gauge Spreads",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].term_structure",
              "pipeline_step": "hazard",
              "cdm_path": null,
              "computation": "IDW-weighted from 3 nearest gauges by distance"
            },
            "property_spread": {
              "label": "Property Fair Spread (bps)",
              "source_file": "data/input/<catchment>/propertyhc.json",
              "source_field": "property_hazard_curves[prop_id].spread",
              "pipeline_step": "propertyhc",
              "cdm_path": null,
              "computation": "from property GEV exceedance, floor-priced at 2bp minimum"
            },
            "basis_waterfall": {
              "label": "Basis Waterfall (5 components)",
              "source_file": null,
              "source_field": "computed at runtime",
              "pipeline_step": "propertyhc",
              "cdm_path": null,
              "computation": "model_uncertainty(±2bp) + distance + elevation + terrain + composition"
            },
            "distance_basis": {
              "label": "Distance Component (bps)",
              "source_file": "data/input/<catchment>/property.json",
              "source_field": "properties[].LocationDetails.DistanceToGauge",
              "pipeline_step": "properties",
              "cdm_path": "Property.LocationDetails",
              "computation": "haversine(property_lat/lon, gauge_lat/lon)"
            },
            "elevation_basis": {
              "label": "Elevation Component (bps)",
              "source_file": "data/input/<catchment>/property.json",
              "source_field": "properties[].LocationDetails.Elevation",
              "pipeline_step": "properties",
              "cdm_path": "Property.LocationDetails.Elevation",
              "computation": "property_elevation - gauge_elevation (m)"
            },
            "flood_transmission_rate": {
              "label": "Flood Transmission Rate (%)",
              "source_file": "data/input/<catchment>/propertyts/PROP-*.json",
              "source_field": "flood_events",
              "pipeline_step": "propertyts",
              "cdm_path": null,
              "computation": "property_flood_count / gauge_flood_count × 100"
            }
          }
        }
      }
    },
    "prs_deal_sheet": {
      "label": "PRS Deal Sheet / Trade Confirmation",
      "generator": "src/port/src/book/book_common.py",
      "sections": {
        "header": {
