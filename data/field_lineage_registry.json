              "pipeline_step": "counterparties",
              "cdm_path": "PhysicalSwap.Header.CounterPartyName",
              "computation": "direct read from CDM"
            },
            "trade_date": {
              "label": "Valuation Date",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.Header.ValuationDate",
