              "source_field": "PhysicalSwap.Pricing.SpreadBps",
              "pipeline_step": "blotter",
              "cdm_path": "PhysicalSwap.Pricing.SpreadBps",
              "computation": "round(fair_spread + uniform(SPREAD_OFFSET_MIN=3, MAX=10))"
            },
            "fair_spread_bps": {
              "label": "Fair Spread (bps)",
              "source_file": "data/input/<catchment>/gaugehc.json",
              "source_field": "hazard_curves[gauge_id][trigger].term_structure[tenor]",
              "pipeline_step": "hazard",
              "cdm_path": "PhysicalSwap.Pricing.FairSpreadBps",
              "computation": "CDS-analogy: protection_leg_pv / risky_annuity × 10000"
            },
            "npv": {
              "label": "NPV (GBP)",
              "source_file": "data/output/prs/<swap_id>.json",
              "source_field": "PhysicalSwap.Pricing.NPV",
              "pipeline_step": "hazard",
              "cdm_path": "PhysicalSwap.Pricing.NPV",
              "computation": "protection_leg_pv - premium_leg_pv (from prs_analytical.py)"
            },
            "yield_curve": {
              "label": "Yield Curve",
              "source_file": "data/output/trading/market_state.json",
              "source_field": "yield_curve",
              "pipeline_step": null,
              "cdm_path": "PhysicalSwap.Pricing.YieldCurve",
              "computation": "DEFAULT_YIELD_CURVE or user-adjusted; interpolated at each tenor"
            }
          }
        }
      }
    },
    "trading_blotter": {
      "label": "Trading Desk Blotter (Tab 1)",
      "generator": "src/visual/interactivity/trading/blotter/",
      "sections": {
        "blotter_table": {
          "label": "Blotter Grid",
          "fields": {
