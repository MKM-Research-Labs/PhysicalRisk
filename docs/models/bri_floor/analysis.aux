\@writefile{toc}{\contentsline {section}{\numberline {1}Sensitivity Analysis}{2}{section.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Floor-level uplift (m) by BRI flood sub-score. No credit at or below 0.38, the full 3.0~m at or above 0.87, linear in between.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:sens_brf_uplift}{{1}{2}{Floor-level uplift (m) by BRI flood sub-score. No credit at or below 0.38, the full 3.0~m at or above 0.87, linear in between}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Adjusted floor level (m) by surveyed floor level and BRI grade mid-point score. The adjustment is additive, so the adjusted level never falls below the surveyed level.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:sens_brf_adjusted}{{2}{2}{Adjusted floor level (m) by surveyed floor level and BRI grade mid-point score. The adjustment is additive, so the adjusted level never falls below the surveyed level}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Letter-grade fallback: representative flood score and resulting uplift. A trailing $+$ modifier is stripped before lookup; unknown or non-applicable grades return no representative score.}}{2}{table.3}\protected@file@percent }
\newlabel{tab:sens_brf_grades}{{3}{2}{Letter-grade fallback: representative flood score and resulting uplift. A trailing $+$ modifier is stripped before lookup; unknown or non-applicable grades return no representative score}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Flood trigger by BRI grade for a property with a 0.3~m surveyed floor level. The credit raises the depth at which the property first floods, which is how the model suppresses PRS flood event counts.}}{3}{table.4}\protected@file@percent }
\newlabel{tab:sens_brf_trigger}{{4}{3}{Flood trigger by BRI grade for a property with a 0.3~m surveyed floor level. The credit raises the depth at which the property first floods, which is how the model suppresses PRS flood event counts}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Damage ratio through the baseline depth-damage curve, evaluated at the depth above the adjusted floor level. The gap between NR and AA at a given water level is the resilience credit expressed as avoided loss.}}{3}{table.5}\protected@file@percent }
\newlabel{tab:sens_brf_residual_damage}{{5}{3}{Damage ratio through the baseline depth-damage curve, evaluated at the depth above the adjusted floor level. The gap between NR and AA at a given water level is the resilience credit expressed as avoided loss}{table.5}{}}
