\newlabel{tab:sens_wd_persistence}{{4}{3}{Persistence multiplier $\Phi (t)$ by hours above the damage-onset threshold ($\phi _{gust}=0.45$, $\tau =4.0$~h). A momentary gust realises only the floor; a prolonged blow saturates at the full peak-curve damage}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Persistence-aware damage ratio (severity $\times $ duration) for a B-grade building at a 27.8~m/s operational threshold.}}{3}{table.5}\protected@file@percent }
