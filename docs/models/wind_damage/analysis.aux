\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces PRS damage-onset trigger by resilience grade. The trigger fires when the peak sustained wind reaches the BRI-adjusted effective threshold, so a resilient building fires less readily at the same wind.}}{3}{table.6}\protected@file@percent }
